# Copy to .env and fill in. Never commit .env.

# --- Database ---------------------------------------------------------------
# Owner role: runs migrations, loads data, writes the knowledge store.
DATABASE_URL=postgresql+psycopg://nl2sql_owner@localhost:5432/nl2sql_research
# Read-only role: the ONLY connection used to execute model-generated SQL.
READONLY_DATABASE_URL=postgresql+psycopg://nl2sql_readonly@localhost:5432/nl2sql_research
STATEMENT_TIMEOUT_MS=15000
MAX_RESULT_ROWS=5000

# --- LLM (any OpenAI-compatible chat-completions endpoint) ------------------
# LLM_PROVIDER=mock runs everything without an API key (tests, smoke runs).
LLM_PROVIDER=openai_compatible
# Base URL of any OpenAI-compatible provider, e.g. https://api.openai.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4096

# --- Embeddings (semantic retrieval) -----------------------------------------
# fastembed = local ONNX model, no key, deterministic.
# openai_compatible = POST /embeddings on EMBEDDING_BASE_URL (defaults to the LLM endpoint + key).
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# --- Retrieval ----------------------------------------------------------------
RETRIEVAL_TOP_K=3
